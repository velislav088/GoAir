@{
    ViewData["Title"] = "Administration";
}

<section class="hero-panel mb-4">
    <div class="hero-panel__content">
        <p class="hero-panel__eyebrow">Administration Area</p>
        <h1 class="hero-panel__title admin-hero__title">Manage the GoAir catalog</h1>
        <p class="hero-panel__description mb-0">
            This workspace is reserved for administrators. Keep schedules, fleet data, airports, tickets, and reviews organized from one cleaner control surface.
        </p>
    </div>
</section>

<section class="admin-hub row g-4">
    <div class="col-md-4">
        <article class="content-card admin-panel h-100">
            <h2 class="section-title h4">Flights</h2>
            <p class="section-subtitle">Create routes, adjust schedules, and remove flights that are no longer valid.</p>
            <a class="btn btn-primary" asp-area="Administration" asp-controller="Flight" asp-action="Index">Manage flights</a>
        </article>
    </div>
    <div class="col-md-4">
        <article class="content-card admin-panel h-100">
            <h2 class="section-title h4">Airports</h2>
            <p class="section-subtitle">Maintain the supported airports and their IATA details.</p>
            <a class="btn btn-primary" asp-area="Administration" asp-controller="Airport" asp-action="Index">Manage airports</a>
        </article>
    </div>
    <div class="col-md-4">
        <article class="content-card admin-panel h-100">
            <h2 class="section-title h4">Aircraft</h2>
            <p class="section-subtitle">Keep the aircraft catalog aligned with capacity and manufacturer data.</p>
            <a class="btn btn-primary" asp-area="Administration" asp-controller="Aircraft" asp-action="Index">Manage aircraft</a>
        </article>
    </div>
    <div class="col-md-6">
        <article class="content-card admin-panel h-100">
            <h2 class="section-title h4">Tickets</h2>
            <p class="section-subtitle">Review all passenger tickets, search reservations, and correct booking details when needed.</p>
            <a class="btn btn-primary" asp-area="Administration" asp-controller="Ticket" asp-action="Index">Manage tickets</a>
        </article>
    </div>
    <div class="col-md-6">
        <article class="content-card admin-panel h-100">
            <h2 class="section-title h4">Reviews</h2>
            <p class="section-subtitle">Moderate customer feedback and inspect review history across all flights.</p>
            <a class="btn btn-primary" asp-area="Administration" asp-controller="Review" asp-action="Index">Manage reviews</a>
        </article>
    </div>
</section>