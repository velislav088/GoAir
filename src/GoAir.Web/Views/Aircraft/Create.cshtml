@model AircraftViewModel

@{
    ViewData["Title"] = "Create Aircraft";
}

<section class="form-shell">
    <div class="form-shell__header">
        <div>
            <p class="form-shell__eyebrow">Fleet</p>
            <h1 class="form-shell__title">Create Aircraft</h1>
            <p class="form-shell__subtitle">Add aircraft details with stronger visual structure and clearer actions.</p>
        </div>
        <a class="btn btn-outline-secondary btn-soft" asp-action="Index">Back to list</a>
    </div>

    <section class="form-card">
        <form asp-action="Create" class="app-form">
            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>

            <div class="form-grid form-grid--two">
                <div class="form-field">
                    <label asp-for="Manufacturer" class="form-label"></label>
                    <input asp-for="Manufacturer" class="form-control" placeholder="Airbus" />
                    <span asp-validation-for="Manufacturer" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Model" class="form-label"></label>
                    <input asp-for="Model" class="form-control" placeholder="A320neo" />
                    <span asp-validation-for="Model" class="text-danger"></span>
                </div>
            </div>

            <div class="form-field">
                <label asp-for="Capacity" class="form-label"></label>
                <input asp-for="Capacity" class="form-control" placeholder="180" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <a class="btn btn-outline-secondary btn-soft" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-primary btn-strong">Create aircraft</button>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}