@model AircraftIndexViewModel

@{
    ViewData["Title"] = "Aircraft";
}

<section class="content-card">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h1 class="section-title mb-1">Aircraft catalog</h1>
            <p class="section-subtitle mb-0">Browse the fleet, filter by manufacturer or model, and review available capacity data.</p>
        </div>
        @if (Model.IsAdmin)
        {
            <a class="btn btn-primary" asp-area="Administration" asp-controller="Aircraft" asp-action="Create">Add Aircraft</a>
        }
    </div>

    <form method="get" class="row g-3 align-items-end mb-4">
        <div class="col-md-9">
            <label class="form-label" asp-for="SearchTerm">Search</label>
            <input class="form-control" asp-for="SearchTerm" placeholder="Manufacturer or model" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-primary flex-fill" type="submit">Apply</button>
            <a class="btn btn-outline-secondary flex-fill" asp-action="Index">Reset</a>
        </div>
    </form>

    @if (Model.Aircraft.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Model</th>
                        <th>Manufacturer</th>
                        <th>Capacity</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (AircraftViewModel item in Model.Aircraft)
                {
                    <tr>
                        <td class="fw-semibold">@item.Model</td>
                        <td>@item.Manufacturer</td>
                        <td>@item.Capacity</td>
                        <td class="text-nowrap">
                            @if (Model.IsAdmin)
                            {
                                <a asp-area="Administration" asp-controller="Aircraft" asp-action="Details" asp-route-id="@item.Id">Details</a>
                                <text> | </text><a asp-area="Administration" asp-controller="Aircraft" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                <text> | </text><a asp-area="Administration" asp-controller="Aircraft" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                            }
                            else
                            {
                                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="empty-state mb-0">No aircraft matched the current search.</p>
    }

    <div class="pagination-bar mt-4">
        <span>Page @Model.CurrentPage of @Model.TotalPages</span>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary @(Model.CurrentPage == 1 ? "disabled" : string.Empty)"
               asp-action="Index"
               asp-route-searchTerm="@Model.SearchTerm"
               asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
            <a class="btn btn-outline-secondary @(Model.CurrentPage == Model.TotalPages ? "disabled" : string.Empty)"
               asp-action="Index"
               asp-route-searchTerm="@Model.SearchTerm"
               asp-route-page="@(Model.CurrentPage + 1)">Next</a>
        </div>
    </div>
</section>