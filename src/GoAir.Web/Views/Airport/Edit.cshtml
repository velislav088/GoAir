@model AirportViewModel

@{
    ViewData["Title"] = "Edit Airport";
}

<section class="form-shell">
    <div class="form-shell__header">
        <div>
            <p class="form-shell__eyebrow">Catalog</p>
            <h1 class="form-shell__title">Edit Airport</h1>
            <p class="form-shell__subtitle">Update airport details from the same polished form layout used across the app.</p>
        </div>
        <a class="btn btn-outline-secondary btn-soft" asp-action="Index">Back to list</a>
    </div>

    <section class="form-card">
        <form asp-action="Edit" class="app-form">
            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-grid form-grid--two">
                <div class="form-field">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="IATACode" class="form-label"></label>
                    <input asp-for="IATACode" class="form-control" />
                    <span asp-validation-for="IATACode" class="text-danger"></span>
                </div>
            </div>

            <div class="form-field">
                <label asp-for="City" class="form-label"></label>
                <input asp-for="City" class="form-control" />
                <span asp-validation-for="City" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <a class="btn btn-outline-secondary btn-soft" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-primary btn-strong">Save changes</button>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}