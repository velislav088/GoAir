@model AirportIndexViewModel

@{
    ViewData["Title"] = "Airports";
}

<section class="content-card">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h1 class="section-title mb-1">Airport network</h1>
            <p class="section-subtitle mb-0">Search supported airports, inspect their IATA codes, and review route coverage.</p>
        </div>
        @if (Model.IsAdmin)
        {
            <a class="btn btn-primary" asp-area="Administration" asp-controller="Airport" asp-action="Create">Add Airport</a>
        }
    </div>

    <form method="get" class="row g-3 align-items-end mb-4">
        <div class="col-md-9">
            <label class="form-label" asp-for="SearchTerm">Search</label>
            <input class="form-control" asp-for="SearchTerm" placeholder="Name, city, or IATA code" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-primary flex-fill" type="submit">Apply</button>
            <a class="btn btn-outline-secondary flex-fill" asp-action="Index">Reset</a>
        </div>
    </form>

    @if (Model.Airports.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>IATA Code</th>
                        <th>City</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (AirportViewModel item in Model.Airports)
                {
                    <tr>
                        <td class="fw-semibold">@item.Name</td>
                        <td>@item.IATACode</td>
                        <td>@item.City</td>
                        <td class="text-nowrap">
                            @if (Model.IsAdmin)
                            {
                                <a asp-area="Administration" asp-controller="Airport" asp-action="Details" asp-route-id="@item.Id">Details</a>
                                <text> | </text><a asp-area="Administration" asp-controller="Airport" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                                <text> | </text><a asp-area="Administration" asp-controller="Airport" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                            }
                            else
                            {
                                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="empty-state mb-0">No airports matched the current search.</p>
    }

    <div class="pagination-bar mt-4">
        <span>Page @Model.CurrentPage of @Model.TotalPages</span>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary @(Model.CurrentPage == 1 ? "disabled" : string.Empty)"
               asp-action="Index"
               asp-route-searchTerm="@Model.SearchTerm"
               asp-route-page="@(Model.CurrentPage - 1)">Previous</a>
            <a class="btn btn-outline-secondary @(Model.CurrentPage == Model.TotalPages ? "disabled" : string.Empty)"
               asp-action="Index"
               asp-route-searchTerm="@Model.SearchTerm"
               asp-route-page="@(Model.CurrentPage + 1)">Next</a>
        </div>
    </div>
</section>