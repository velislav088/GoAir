@model HomeLandingViewModel

@{
    ViewData["Title"] = "GoAir Command Center";
}

<section class="hero-panel mb-4">
    <div class="hero-panel__content">
        <p class="hero-panel__eyebrow">GoAir Operations</p>
        <h1 class="hero-panel__title">Keep routes, aircraft, tickets, and passenger feedback in one place.</h1>
        <p class="hero-panel__description">
            Browse live routes as a guest, manage your own bookings and reviews as a member, and oversee the catalog as an administrator.
        </p>
        <div class="hero-panel__actions">
            <a class="btn btn-primary" asp-controller="Flight" asp-action="Index">Browse flights</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="btn btn-outline-light" asp-controller="Ticket" asp-action="Index">Open my tickets</a>
            }
            else
            {
                <a class="btn btn-outline-light" asp-area="Identity" asp-page="/Account/Register">Create account</a>
            }
        </div>
    </div>
</section>

<section class="stats-grid mb-4">
    <article class="stat-card">
        <span class="stat-card__label">Airports</span>
        <strong class="stat-card__value">@Model.AirportCount</strong>
    </article>
    <article class="stat-card">
        <span class="stat-card__label">Aircraft</span>
        <strong class="stat-card__value">@Model.AircraftCount</strong>
    </article>
    <article class="stat-card">
        <span class="stat-card__label">Flights</span>
        <strong class="stat-card__value">@Model.ScheduledFlightCount</strong>
    </article>
    <article class="stat-card">
        <span class="stat-card__label">Tickets</span>
        <strong class="stat-card__value">@Model.TicketCount</strong>
    </article>
    <article class="stat-card">
        <span class="stat-card__label">Reviews</span>
        <strong class="stat-card__value">@Model.ReviewCount</strong>
    </article>
</section>

<section class="content-card">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h2 class="section-title mb-1">Upcoming flights</h2>
            <p class="section-subtitle mb-0">A quick look at the next departures in the system.</p>
        </div>
        <a class="btn btn-outline-primary" asp-controller="Flight" asp-action="Index">View all flights</a>
    </div>

    @if (Model.UpcomingFlights.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Flight</th>
                        <th>Route</th>
                        <th>Departure</th>
                        <th>Status</th>
                        <th>Aircraft</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (FlightViewModel flight in Model.UpcomingFlights)
                {
                    <tr>
                        <td class="fw-semibold">@flight.FlightNumber</td>
                        <td>@flight.DepartureAirport to @flight.ArrivalAirport</td>
                        <td>@flight.DepartureTime.ToString("g")</td>
                        <td>@flight.Status</td>
                        <td>@flight.Aircraft</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="empty-state mb-0">No flights are scheduled yet. Seed data will populate the first routes automatically.</p>
    }
</section>