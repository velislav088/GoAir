@{
    ViewData["Title"] = "Privacy";
}

<section class="content-card">
    <h1 class="section-title">Privacy and access</h1>
    <p class="section-subtitle">
        GoAir stores flights, aircraft, airports, tickets, and reviews for demonstration purposes inside the local project database.
    </p>
    <ul class="mb-0">
        <li>Guests can browse public catalog data such as flights, airports, and aircraft.</li>
        <li>Authenticated users manage only their own tickets and reviews.</li>
        <li>Administrators manage the operational catalog and seeded sample data.</li>
    </ul>
</section>