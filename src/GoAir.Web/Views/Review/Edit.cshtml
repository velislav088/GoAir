@model ReviewFormViewModel

@{
    ViewData["Title"] = "Edit Review";
}

<section class="form-shell">
    <div class="form-shell__header">
        <div>
            <p class="form-shell__eyebrow">Reviews</p>
            <h1 class="form-shell__title">Edit Review</h1>
            <p class="form-shell__subtitle">Adjust passenger feedback with better spacing and more forgiving date behavior.</p>
        </div>
        <a class="btn btn-outline-secondary btn-soft" asp-action="Index">Back to list</a>
    </div>

    <section class="form-card">
        <form asp-action="Edit" class="app-form">
            <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-grid form-grid--two">
                <div class="form-field">
                    <label asp-for="Rating" class="form-label"></label>
                    <input asp-for="Rating" class="form-control" min="1" max="5" />
                    <span asp-validation-for="Rating" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="CreatedOn" class="form-label"></label>
                    <input asp-for="CreatedOn" class="form-control" type="datetime-local" />
                    <div class="form-hint">Optional. Clear it to keep the current saved review time.</div>
                    <span asp-validation-for="CreatedOn" class="text-danger"></span>
                </div>
            </div>

            <div class="form-field">
                <label asp-for="Comment" class="form-label"></label>
                <textarea asp-for="Comment" class="form-control form-control--textarea" rows="4"></textarea>
                <span asp-validation-for="Comment" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="FlightId" class="form-label"></label>
                <select asp-for="FlightId"
                        class="form-select"
                        asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Flights, nameof(LookupOptionViewModel.Value), nameof(LookupOptionViewModel.Text)))"></select>
                <span asp-validation-for="FlightId" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <a class="btn btn-outline-secondary btn-soft" asp-action="Index">Cancel</a>
                <button type="submit" class="btn btn-primary btn-strong">Save changes</button>
            </div>
        </form>
    </section>
</section>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}