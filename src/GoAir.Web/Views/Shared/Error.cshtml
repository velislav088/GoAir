@model ErrorViewModel
@{
    ViewData["Title"] = "500 Server Error";
}

<section class="error-page error-page-server">
    <div class="error-page__content">
        <p class="error-page__eyebrow">GoAir Support</p>
        <h1 class="error-page__code">500</h1>
        <h2 class="error-page__title">Something went wrong on our side.</h2>
        <p class="error-page__description">
            We could not complete your request right now. Try again in a moment or head back to the homepage.
        </p>

        <div class="error-page__actions">
            <a class="btn btn-primary error-page__button" asp-controller="Home" asp-action="Index">Return Home</a>
            <a class="btn btn-outline-light error-page__button" asp-controller="Home" asp-action="Privacy">View Privacy</a>
        </div>

        @if (Model.ShowRequestId)
        {
            <p class="error-page__request-id">
                Request ID: <code>@Model.RequestId</code>
            </p>
        }
    </div>
</section>
