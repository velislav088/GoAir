@using GoAir.Data.Models
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav auth-nav align-items-lg-center gap-lg-2">
@if (SignInManager.IsSignedIn(User))
{
    @if (User.IsInRole(ApplicationRoles.Administrator))
    {
        <li class="nav-item">
            <span class="nav-link text-dark fw-semibold auth-badge">Administrator</span>
        </li>
    }
    <li class="nav-item">
        <a class="nav-link text-dark auth-link" asp-area="Identity" asp-page="/Account/Manage/Index" title="Manage">Hello @User.Identity?.Name!</a>
    </li>
    <li class="nav-item">
        <form class="auth-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link text-dark auth-link auth-button">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark auth-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark auth-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>