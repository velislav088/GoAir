@model TicketFormViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Ticket</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="SeatNumber" class="control-label"></label>
                <input asp-for="SeatNumber" class="form-control" />
                <span asp-validation-for="SeatNumber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FareClass" class="control-label"></label>
                <select asp-for="FareClass" class="form-control" asp-items="Html.GetEnumSelectList<GoAir.Data.Models.FareClass>()"></select>
                <span asp-validation-for="FareClass" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="PurchasedOn" class="control-label"></label>
                <input asp-for="PurchasedOn" class="form-control" />
                <span asp-validation-for="PurchasedOn" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UserId" class="control-label"></label>
                <select asp-for="UserId"
                        class="form-control"
                        asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Users, nameof(LookupOptionViewModel.Value), nameof(LookupOptionViewModel.Text)))"></select>
                <span asp-validation-for="UserId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="FlightId" class="control-label"></label>
                <select asp-for="FlightId"
                        class="form-control"
                        asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Flights, nameof(LookupOptionViewModel.Value), nameof(LookupOptionViewModel.Text)))"></select>
                <span asp-validation-for="FlightId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}