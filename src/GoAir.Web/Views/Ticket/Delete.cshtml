@model TicketViewModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Ticket</h4>
    <hr />
    <div asp-validation-summary="All" class="text-danger"></div>
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.SeatNumber)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.SeatNumber)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Price)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Price)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.FareClass)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.FareClass)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.PurchasedOn)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.PurchasedOn)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.User)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.User)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Flight)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Flight)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a class="btn btn-outline-secondary btn-soft" asp-action="Index">Back to list</a>
    </form>
</div>